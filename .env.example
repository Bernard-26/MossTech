# Copy this file to ".env" and change the values. Do NOT put quotes or a # inside a value
# (a # starts a comment). Never share or upload your real .env file.

PORT=3000
HOST=127.0.0.1
# "production" turns on Secure cookies + HSTS + HTTPS redirect. Use it only when the site is served over HTTPS.
NODE_ENV=development
# Set to 1 only if the site runs behind a hosting proxy (Render, Railway, nginx, Cloudflare...)
TRUST_PROXY=0

# Needed to create administrator accounts and to reset an admin password. It is the master key of the site:
# 12+ chars with upper, lower, number, symbol, no # inside. Use a long unique value and never reuse a real password.
ADMIN_PASSKEY=

# 1 = every administrator MUST turn on 2FA (authenticator app) before the admin panel works. Strongly recommended.
REQUIRE_ADMIN_2FA=1

# ---- Email (verification codes + password reset) ----
# 1 = new accounts must enter a 6-digit code sent to their email. 0 = turn verification off.
REQUIRE_EMAIL_VERIFICATION=1
# Leave everything below empty while testing: codes are then printed in the server window instead.
#
# OPTION A (use this when hosted on Render/Railway etc.): Brevo email API over HTTPS.
#   Free account at brevo.com -> verify your sender email -> SMTP & API -> create an API key.
BREVO_API_KEY=
#
# OPTION B (fine on your own computer): any SMTP service. Render's FREE plan blocks SMTP ports.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
#                SMTP_PASS=<16-character Google "App password">
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MOSSTECH <you@gmail.com>

# ---- Optional: create the first admin automatically (for hosts that wipe files on redeploy) ----
SEED_ADMIN_USERNAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ---- Optional: where the database file lives (use your host's persistent disk path) ----
# DB_PATH=/var/data/mosstech.db
