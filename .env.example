# Copy this file to ".env" and change the values. Do NOT put quotes or a # inside a value
# (a # starts a comment). Never share, commit or upload your real .env file.

# =====================================================================
#  DATABASE (PostgreSQL)
# =====================================================================
# --- Used by docker-compose.yml: it creates the database with these, and the app connects with them.
POSTGRES_USER=mosstech
# REQUIRED. Use a long random value. Avoid # $ and quote characters inside it.
POSTGRES_PASSWORD=
POSTGRES_DB=mosstech

# --- Running the app OUTSIDE Docker (npm start) against any PostgreSQL? Use ONE of these two styles:
# DATABASE_URL=postgres://mosstech:YOUR_PASSWORD@localhost:5432/mosstech     (URL-encode special characters in the password)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=mosstech
# DB_USER=mosstech
# DB_PASSWORD=
# Managed databases (Render, Neon, Supabase, RDS...) usually need TLS:
# DB_SSL=1
# Startup retries: how long the app waits for PostgreSQL before giving up (30 tries, growing delay)
# DB_CONNECT_RETRIES=30
# DB_CONNECT_DELAY_MS=2000
# DB_POOL_MAX=10
# 1 = create/upgrade the tables automatically on every start (default). 0 = only when you run "npm run migrate".
# AUTO_MIGRATE=1

# =====================================================================
#  WEB SERVER
# =====================================================================
# Docker: the host port you open in the browser, and which address it listens on.
# 127.0.0.1 = only this computer. Use 0.0.0.0 to reach it from other devices on your network.
APP_PORT=3000
APP_BIND=127.0.0.1
# Without Docker only: PORT and HOST (docker-compose.yml fixes HOST to 0.0.0.0 inside the container).
PORT=3000
HOST=127.0.0.1
# "production" turns on Secure cookies + HSTS + HTTPS redirect. Use it ONLY when the site is served over HTTPS
# (for example behind the Caddy profile). For testing on http://localhost keep "development".
NODE_ENV=development
# Set to 1 only if the site runs behind a proxy (Caddy, nginx, Cloudflare, Render...)
TRUST_PROXY=0
# Only for the optional HTTPS proxy: docker compose --profile proxy up -d
# DOMAIN=shop.example.com

# =====================================================================
#  SECURITY / ACCOUNTS
# =====================================================================
# Needed to create administrator accounts and to reset an admin password. It is the master key of the site:
# 12+ chars with upper, lower, number, symbol, no # inside. Use a long unique value and never reuse a real password.
ADMIN_PASSKEY=

# 1 = every administrator MUST turn on 2FA (authenticator app) before the admin panel works. Strongly recommended.
REQUIRE_ADMIN_2FA=1

# ---- Email (verification codes + password reset) ----
# 1 = new accounts must enter a 6-digit code sent to their email. 0 = turn verification off.
REQUIRE_EMAIL_VERIFICATION=1
# Leave everything below empty while testing: codes are then printed in the server log instead
# (docker compose logs -f app).
#
# OPTION A (use this on hosted servers): Brevo email API over HTTPS.
#   Free account at brevo.com -> verify your sender email -> SMTP & API -> create an API key.
BREVO_API_KEY=
#
# OPTION B: any SMTP service. Many cloud hosts block SMTP ports.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
#                SMTP_PASS=<16-character Google "App password">
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MOSSTECH <you@gmail.com>

# ---- Optional: create the first admin automatically ----
SEED_ADMIN_USERNAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# =====================================================================
#  BACKUPS (pg_dump files; in Docker they go to the "app_backups" volume)
# =====================================================================
# BACKUP_EVERY_HOURS=24      (0 = off)
# BACKUP_KEEP=7
# BACKUP_DIR=./backups       (outside Docker only)
